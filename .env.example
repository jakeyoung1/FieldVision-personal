# Copy to .env for local runs. On Render, set these in the dashboard (Environment),
# never in a committed file. Leave values blank here.

# Required. Claude API key for scouting reports.
ANTHROPIC_API_KEY=

# Scout key: a shared secret for the coaching staff. Required to write grade
# overrides and report timings, and to read the player-level decision log.
# Without it, those routes refuse every request. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
FV_SCOUT_KEY=

# Local development only: allow writes with no scout key. Never set on a public deployment.
FV_ALLOW_OPEN_WRITES=

# Durable storage for overrides and timings. Any Postgres connection string,
# e.g. postgresql://user:password@host:5432/dbname. When blank, records go to a
# local SQLite file, which Render's free plan wipes on every restart and deploy.
# Production uses Neon's free plan: paste its connection string as-is, keeping
# ?sslmode=require. Check it first with: python scripts/check_database.py
DATABASE_URL=

# Optional: SQLite file path when DATABASE_URL is blank. It survives a restart only
# on a persistent disk, which the app cannot verify, so the app never reports SQLite as durable.
FV_AUDIT_DB=

# Tests only: a throwaway Postgres for the storage tests (they drop its tables).
# Never the same value as DATABASE_URL; the test run refuses to start if it is.
# The test suite ignores DATABASE_URL and this file entirely otherwise.
FV_TEST_DATABASE_URL=

# Optional guardrails (defaults shown in render.yaml).
FV_RATE_LIMIT=
FV_RATE_WINDOW=
FV_ALLOWED_ORIGINS=
